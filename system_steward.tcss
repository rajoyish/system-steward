/* ── Base ─────────────────────────────────────────────────────────────── */
Screen { background: #0c1218; color: #dde7ef; }
.topbar { height: 1; padding: 0 2; background: #121c25; }
.brand { width: auto; height: 1; color: #71e5bb; text-style: bold; margin-right: 3; }
.top-context { width: 1fr; height: 1; color: #8395a5; }
.topbar Button { width: auto; }
.eyebrow { color: #8395a5; text-style: bold; height: 1; margin-bottom: 1; }
.metric-value { height: auto; text-style: bold; color: #dde7ef; }
.panel { border: round #293b4a; background: #121c25; }
Button { min-width: 12; height: 3; background: #1b2a37; border: tall #1b2a37; color: #b7c8d6; }
Button:hover { background: #263c4a; border: tall #263c4a; }
Button:focus { text-style: bold; border: tall #71e5bb; }
Button.-primary { background: #71e5bb; color: #0c211a; border: tall #71e5bb; text-style: bold; }
Button.-error { background: #d96b75; color: #140b10; border: tall #d96b75; text-style: bold; }
Button:disabled { opacity: 45%; }
Button.-textual-compact { height: 1; min-width: 0; width: auto; padding: 0 1; border: none; }
Button.-textual-compact:hover, Button.-textual-compact:focus { border: none; }
Button.-textual-compact:focus { background: #234b46; color: #e3fff4; }
Button.-textual-compact.-primary { background: #71e5bb; color: #0c211a; }
Input:focus { border: tall #71e5bb; }
Footer { background: #121c25; color: #8395a5; }
DataTable > .datatable--header { background: #1b2a37; color: #8395a5; text-style: bold; }
DataTable > .datatable--cursor { background: #1b2a37; color: #dde7ef; }
DataTable:focus > .datatable--cursor { background: #234b46; color: #e3fff4; }
DataTable > .datatable--even-row { background: #121c25; }
DataTable > .datatable--odd-row { background: #15202a; }
DataTable:focus { border: none; }
Tabs Tab { color: #8395a5; }
Tabs Tab.-active { color: #71e5bb; text-style: bold; }
Tabs:focus Tab.-active { background: #223e3d; }
#too-small { display: none; text-align: center; padding: 2; }
.tiny #view-switcher { display: none; }
.tiny #too-small { display: block; }

/* ── Main screen: top bar with view tabs ──────────────────────────────── */
#topbar { height: 2; }
#app-identity { width: auto; height: 2; margin-right: 3; }
#app-identity .brand { margin-right: 0; }
#author { height: 1; color: #dde7ef; padding-left: 3; }
#views { width: 1fr; height: 2; background: transparent; }
#keep-awake { color: #8395a5; background: #1b2a37; }
#keep-awake.-on { color: #0c211a; background: #71e5bb; text-style: bold; }
#view-switcher { height: 1fr; }

/* ── Dashboard ────────────────────────────────────────────────────────── */
#dashboard { height: 1fr; padding: 0 2 1 2; }
.section-heading { height: 1; margin-top: 1; }
.section-heading .eyebrow { width: auto; margin: 0 2 0 0; }
#dashboard-health-status, .section-note { width: 1fr; height: 1; color: #66798a; text-style: none; }
.card-grid { layout: grid; grid-size: 4; grid-gutter: 0 1; height: auto; margin-top: 1; }
#metric-grid { grid-rows: 6; }
#tool-grid { grid-rows: 4; }
.narrow .card-grid { grid-size: 2; }
.system-metric, .feature-card { width: 1fr; height: 100%; min-width: 0; padding: 0 1; border: round #293b4a;
    background: #121c25; content-align: left top; text-align: left; text-style: none; }
.system-metric:hover, .feature-card:hover { border: round #526b7e; background: #17232e; }
.system-metric:focus, .feature-card:focus { border: round #71e5bb; background: #142a28; text-style: none; }
.system-metric:hover, .feature-card:hover { text-style: none; }
#dashboard-panels { height: 15; margin-top: 1; }
#processes-panel { width: 1fr; margin-right: 1; padding: 0 1; }
#storage-panel { width: 1fr; padding: 0 1; }
.panel .section-heading { margin: 0 0 1 0; }
#storage-panel .section-heading .eyebrow { width: 1fr; }
#processes-panel .eyebrow { margin-bottom: 1; }
#top-processes { height: 1fr; background: #121c25; }
#storage-breakdown { height: 1fr; }
.narrow #dashboard-panels { layout: vertical; height: auto; }
.narrow #processes-panel, .narrow #storage-panel { width: 100%; height: 14; margin: 0 0 1 0; }

/* ── Storage explorer ─────────────────────────────────────────────────── */
#storage { height: 1fr; padding: 1 2 0 2; }
#main-panel { height: 1fr; }
#table-toolbar { height: 3; padding: 0 1; }
#scope { width: 1fr; height: 2; margin-top: 1; }
#scope-title { height: 1; }
#scope-path { height: 1; color: #66798a; text-style: none; }
#search { width: 32; height: 3; border: tall transparent; background: #17232e; }
#explore-navigation { height: 2; padding: 0 1; margin-top: 1; }
#navigation { width: 1fr; height: 2; background: transparent; }
#inspector-panes { height: 1fr; }
#files { width: 1fr; height: 1fr; background: #121c25; }
#details { width: 34; border-left: solid #293b4a; padding: 0 2; }
#detail-name { height: auto; color: #dde7ef; }
#detail-size { margin-top: 1; color: #71e5bb; }
#detail-status { height: auto; color: #66798a; text-style: none; }
#detail-path { height: auto; color: #b1c2cf; margin: 1 0; }
#explore { width: 100%; }
#table-actions { height: 1; padding: 0 1; margin: 1 0 0 0; }
#table-actions Button { margin-right: 1; }
#storage-hint { width: 1fr; color: #526b7e; text-align: right; text-style: none; }
.narrow #details { display: none; }
.narrow #storage { padding: 0 1; }
.narrow #search { width: 22; }
.narrow #storage-hint { display: none; }
.narrow #dashboard { padding: 0 1 1 1; }

/* ── Cleanup screens ──────────────────────────────────────────────────── */
.page-title { height: 2; text-style: bold; color: #e1edf5; }
#cleanup-workspace { padding: 1 2; }
#steps { height: 2; color: #71e5bb; }
#cleanup-toolbar { height: 4; }
#cleanup-scope { width: 1fr; margin-right: 2; }
#adobe-scope { width: 1fr; color: #66798a; text-style: none; padding-top: 1; }
#cleanup-toolbar Button { margin-left: 1; }
#cleanup-panes { height: 1fr; }
#cleanup-list-panel { width: 2fr; padding: 1; margin-right: 1; }
#cleanup-state { height: 2; color: #66798a; text-style: none; }
#cleanup-list { height: 1fr; border: none; background: transparent; }
SelectionList > .option-list--option-highlighted { background: #234b46; color: #dde7ef; }
SelectionList > .selection-list--button { color: #334b5d; background: #334b5d; }
SelectionList > .selection-list--button-highlighted { color: #526b7e; background: #526b7e; }
SelectionList > .selection-list--button-selected { color: #71e5bb; background: #234b46; }
SelectionList > .selection-list--button-selected-highlighted { color: #71e5bb; background: #234b46; }
#cleanup-progress { height: 1; width: 100%; }
#cleanup-progress Bar { width: 1fr; }
#cleanup-details { width: 1fr; min-width: 24; padding: 1 2; }
#group-detail { height: auto; margin-bottom: 2; }
#preserved { height: auto; color: #71e5bb; margin-bottom: 2; }
#cleanup-details Button { width: 100%; margin-bottom: 1; }
#selection-summary { height: 2; padding-top: 1; color: #71e5bb; }
#cleanup-actions { height: 3; }
#cleanup-note { width: 1fr; color: #66798a; text-style: none; padding-right: 2; }
#cleanup-actions Button { margin-left: 1; }
#cleanup-result { display: none; height: auto; max-height: 5; color: #edbf75; margin-bottom: 1; }
#stop-cleanup { display: none; }
#stop-cleanup:enabled { display: block; }
.dialog { background: #15212c; border: round #3d5a6a; padding: 1 3; width: 80; max-width: 95%; max-height: 95%; }
ModalScreen { background: #05090db3; align: center middle; }
.dialog-title { height: auto; text-style: bold; color: #e1edf5; margin-bottom: 1; }
#confirm-dialog { height: 90%; max-height: 38; }
#confirm-summary { height: 2; color: #71e5bb; }
#confirm-paths { height: 1fr; min-height: 2; margin-bottom: 1; background: #101a23; padding: 0 1; }
#confirm-paths Static { height: auto; }
#confirm-warning { height: auto; color: #edbf75; margin-bottom: 1; }
#confirm-status { height: auto; min-height: 1; color: #edbf75; margin-bottom: 1; }
.dialog-actions { height: 3; align-horizontal: right; }
.dialog-actions Button { margin-left: 1; }
#info-dialog { height: 80%; }
#info-dialog VerticalScroll { height: 1fr; }
#info-dialog Static { height: auto; }
#close-info { margin-top: 1; align-horizontal: right; }
.narrow #cleanup-details { display: none; }
.narrow #cleanup-note { display: none; }
.short #cleanup-workspace { padding: 0 1; }
.short .page-title, .short #steps { height: 1; }
.short #cleanup-toolbar { height: 3; }
.short #selection-summary { height: 1; padding: 0; }
.short #cleanup-list-panel { padding: 0 1; }
.short #confirm-dialog { padding: 0 2; height: 100%; max-height: 100%; }
.short #confirm-warning, .short #confirm-status, .short .dialog-title { margin-bottom: 0; }
.short #confirm-dialog .eyebrow { display: none; }
.short #confirm-summary { height: 1; }

/* Native system health and maintenance workspace. */
#maintenance-workspace { padding: 1 2; }
#maintenance-toolbar, #maintenance-actions { height: 3; }
#maintenance-feature { width: 1fr; margin-right: 1; }
#maintenance-refresh { width: 16; }
#maintenance-summary { height: auto; max-height: 4; color: #71e5bb; margin: 1 0; }
#health-interval { width: 18; margin-right: 1; }
#maintenance-path { height: 3; }
#maintenance-note { height: auto; max-height: 4; color: #66798a; text-style: none; margin-bottom: 1; }
#health-table, #maintenance-list, #maintenance-log { height: 1fr; min-height: 3; background: #121c25; }
#maintenance-detail-panel { height: 7; min-height: 3; margin: 1 0; padding: 0 1; }
#maintenance-detail { height: auto; }
#maintenance-actions { overflow-x: auto; }
#maintenance-actions Button { margin-right: 1; min-width: 12; width: auto; }
#maintenance-confirm { height: 85%; }
#maintenance-confirm VerticalScroll { height: 1fr; margin-bottom: 1; }
#maintenance-confirm Static { height: auto; }
.narrow #maintenance-workspace { padding: 0 1; }
.narrow #maintenance-detail-panel { height: 5; margin: 0; }
.narrow #maintenance-summary { margin: 0; }
.short #maintenance-workspace { padding: 0 1; }
.short #maintenance-summary { margin: 0; max-height: 2; }
.short #maintenance-note { max-height: 2; margin: 0; }
.short #maintenance-detail-panel { height: 3; min-height: 2; margin: 0; }
.short #maintenance-list, .short #maintenance-log { min-height: 2; }

/* ── Confirmations and Keep Awake ─────────────────────────────────────── */
.confirmation-hint { height: auto; color: #66798a; text-style: none; margin-bottom: 1; }
.short .confirmation-hint { margin-bottom: 0; }

/* Keep Awake settings scroll independently in smaller terminals. */
#awake-workspace { padding: 1 2; }
#awake-workspace Label, #awake-workspace Static { height: auto; }
#awake-workspace .eyebrow { margin-top: 1; }
#awake-workspace Checkbox { height: 3; width: 100%; }
.awake-copy { color: #66798a; text-style: none; margin-bottom: 1; }
#awake-status { color: #71e5bb; margin: 1 0; }
#awake-actions { height: 3; margin: 1 0; }
#awake-actions Button { width: auto; margin-right: 1; }
#awake-output { color: #b7c8d6; }
